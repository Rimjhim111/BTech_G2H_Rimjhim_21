#include<stdio.h>
 int main()
  {
   int rev=0,n,d;
   printf("enter a number:");
   scanf("%d",&n);
   int num=n;
   
    while(num!=0){
        d=num%10;
        rev= rev*10+d;
        num=num/10;
    }
    if(rev==n)
    printf("palindrome number");
    else
    printf("not a palindrome number");
    return 0;
}
