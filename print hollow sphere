#include <stdio.h>

int main() {
    int i,j;
    for(i=0;i<4;i++)
    {
      for(j=0;j<4;j++)
        {
            if(i==0||i==3||j==0||j==3)
            {
                printf("*\t");
            }
            else {
                printf(" \t");
            }
        }
        printf("\n");
    }
    return 0;
}
