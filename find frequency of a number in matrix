#include <stdio.h>

int main() {
    int n1,n2,s=0,i,j;
    int num,count=0;
    printf("Enter number to find Frequency:");
    scanf("%d",&num);
    printf("enter rows:");
    scanf("%d",&n1);
    printf("enter columns:");
    scanf("%d",&n2);
    int a[n1][n2];
    printf("Enter elements:");
    for(i=0;i<n1;i++)
    {
        for(j=0;j<n2;j++)
        {
         scanf("%d",&a[i][j]);   
        }
    }
    
    for(i=0;i<n1;i++)
    {
        for(j=0;j<n2;j++)
        {
            if(num==a[i][j]) 
            {
                count++;
            }
        }
    }
    
    printf("Frequency of %d in matrix is %d",num,count);
    return 0;
}
