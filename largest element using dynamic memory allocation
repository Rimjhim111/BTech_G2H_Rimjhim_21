#include <stdio.h>
#include<stdlib.h>

int main() {
    int *ptr,i,max;
    ptr=(int*)malloc(20*sizeof(int));
    printf("enter 20 integers:\n");
    for(i=0;i<20;i++)
       scanf("%d",&ptr[i]);
    max=ptr[0];
    for(i=1;i<20;i++){
        if(ptr[i]>max)
          max=ptr[i];
    }
    printf("the largest number is %d",max);
    return 0;
}
