#include <stdio.h>

int main() {
    int num,term1,term2,nextterm;
    term1=0,term2=1;
    printf("enter the number of terms:");
    scanf("%d",&num);
    printf("fibonacci series %d\t%d\t",term1,term2);
    for(int i=3;i<=num;i++)
    {
        nextterm=term1+term2;
        printf("%d\t",nextterm);
        term1=term2;
        term2=nextterm;
        nextterm=term1+term2;
    }
    return 0;
}
